# From App Dashboard > your app > API setup with Instagram login. Use the
# "Instagram app ID" and "Instagram app secret" shown in that section - NOT
# the Meta app ID/secret from Settings > Basic, which the token endpoints
# reject. Not a Facebook Page / Business login app either.
META_APP_ID=
META_APP_SECRET=
META_REDIRECT_URI=http://localhost:3000/auth/instagram/callback

DATABASE_URL=postgres://user:pass@localhost:5432/ugc_market

# 32-byte key, base64-encoded. Generate with:
# node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
ENCRYPTION_KEY=

PORT=3000
CRON_SCHEDULE=0 6 * * *
GRAPH_API_VERSION=v21.0
